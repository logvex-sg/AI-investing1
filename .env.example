# ECOSYSTEM configuration — copy to .env and fill in.
# Never commit the real .env file.

ECOSYSTEM_ENVIRONMENT=development

# Database (PostgreSQL + pgvector)
ECOSYSTEM_DATABASE_URL=postgresql+asyncpg://ecosystem:CHANGE_ME@127.0.0.1:5432/ecosystem

# Session / token signing. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
ECOSYSTEM_SECRET_KEY=CHANGE_ME

# LLM inference. provider = ollama | mock
ECOSYSTEM_LLM_PROVIDER=mock
ECOSYSTEM_OLLAMA_BASE_URL=http://127.0.0.1:11434
ECOSYSTEM_OVERSEER_MODEL=qwen2.5:7b-instruct
ECOSYSTEM_AGENT_MODEL=qwen2.5:7b-instruct
ECOSYSTEM_CODING_MODEL=qwen2.5-coder:7b-instruct

# Bounded context windows keep the system usable on 16 GB RAM
ECOSYSTEM_LLM_MAX_CONTEXT_TOKENS=4096
ECOSYSTEM_LLM_MAX_CONCURRENCY=1

# Execution safety. Only "simulated" and "paper" are enabled by default.
ECOSYSTEM_ENABLE_TESTNET_ADAPTER=false
ECOSYSTEM_ENABLE_PRODUCTION_ADAPTER=false

# Risk defaults (deterministic; not modifiable by agents)
ECOSYSTEM_RISK_MAX_POSITION_PCT=0.25
ECOSYSTEM_RISK_MAX_EXPOSURE_PCT=0.80
ECOSYSTEM_RISK_MAX_DRAWDOWN_PCT=0.20
ECOSYSTEM_RISK_MAX_DAILY_LOSS_PCT=0.05
ECOSYSTEM_RISK_MAX_CONCENTRATION_PCT=0.40
ECOSYSTEM_RISK_MAX_TRADES_PER_DAY=20

# Treasury defaults (EUR)
ECOSYSTEM_TREASURY_TOTAL_CAPITAL=10000.0
